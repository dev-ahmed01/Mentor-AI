# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/mentorai
DATABASE_USERNAME=mentorai
DATABASE_PASSWORD=change-me

# Authentication (at least 32 random characters; never reuse this example)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION=PT8H

# Browser/API
DEMO_ENABLED=false
API_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional public market evidence collection (fixed Arbeitnow endpoint; six-hour cooldown)
MARKET_COLLECTION_ENABLED=false
MARKET_REFRESH_ON_START=false

# Local AI (used from the AI phase onward)
MENTOR_AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
